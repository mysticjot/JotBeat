  "free_chain": [
    { "provider": "groq", "env_key": "GROQ_API_KEY" },
    { "provider": "cerebras", "env_key": "CEREBRAS_API_KEY" },
    { "provider": "google", "env_key": "GEMINI_API_KEY" },
