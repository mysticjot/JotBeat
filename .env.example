# JotBeat provider keys — copy to .env and fill in. NEVER commit .env.
# models.py activates only providers whose key is present and non-empty.

# --- Paid specialists ---
DEEPSEEK_API_KEY=
KIMI_API_KEY=            # platform.moonshot.ai
GLM_API_KEY=             # z.ai (international)
MINIMAX_API_KEY=         # platform.minimax.io
FAL_API_KEY=             # fal.ai — art overflow fallback

# --- Free chain ---
GEMINI_API_KEY=          # Google AI Studio
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=      # optional master router
GITHUB_TOKEN=            # GitHub Models via PAT

# --- Platform accounts (not REST keys; documented for completeness) ---
# Kaggle: account-driven, uses ~/.kaggle/kaggle.json — do not duplicate here
